rules_version = '2';

// =====================================================================
//  Règles de sécurité de la base de données "Maison"
//
//  À COPIER dans la console Firebase : Firestore Database > Règles.
//  Avant de publier, remplace UID_PERSONNE_1 et UID_PERSONNE_2 par vos
//  deux identifiants (Authentication > Utilisateurs > colonne "UID").
//  Ne mets PAS vos vrais UID dans ce fichier sur GitHub.
// =====================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Les deux seuls comptes autorisés ----
    function uids() {
      return ['UID_PERSONNE_1', 'UID_PERSONNE_2'];
    }
    function isMember() {
      return request.auth != null && request.auth.uid in uids();
    }
    function isDay(s) {
      return s is string && s.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---- Prénom et couleur de chacun ----
    match /members/{uid} {
      allow read: if isMember();
      // Chacun ne peut modifier que son propre profil
      allow create, update: if isMember() && request.auth.uid == uid && validMember(request.resource.data);
      allow delete: if false;
    }
    function validMember(d) {
      return d.keys().hasOnly(['name', 'color', 'updatedAt'])
        && d.name is string && d.name.size() > 0 && d.name.size() <= 30
        && d.color is string && d.color.matches('^#[0-9A-Fa-f]{6}$')
        && d.updatedAt == request.time;
    }

    // ---- Tâches ----
    match /tasks/{taskId} {
      allow read: if isMember();
      allow create, update: if isMember() && validTask(request.resource.data);
      // Aucun effacement définitif : une tâche supprimée est seulement masquée
      allow delete: if false;
    }
    function validTask(d) {
      return d.keys().hasAll(['title', 'date', 'assignee', 'completions', 'deleted', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.keys().hasOnly(['title', 'date', 'assignee', 'comment', 'completions', 'repeat', 'deleted', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 120
        && isDay(d.date)
        && (d.assignee == 'both' || d.assignee in uids())
        && (!('comment' in d) || (d.comment is string && d.comment.size() <= 500))
        && d.completions is map
        && (!('repeat' in d) || d.repeat == null || d.repeat is map)
        && d.deleted is bool
        && (!('deletedAt' in d) || d.deletedAt is number)
        && d.createdBy in uids()
        && d.createdAt is number
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.v is int;
    }

    // ---- Notes partagées et rappels ----
    match /notes/{noteId} {
      allow read: if isMember();
      allow create, update: if isMember() && validNote(request.resource.data);
      // Aucun effacement définitif : une note supprimée est seulement masquée
      allow delete: if false;
    }
    function validNote(d) {
      return d.keys().hasAll(['kind', 'text', 'done', 'deleted', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.keys().hasOnly(['kind', 'text', 'done', 'deleted', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.kind in ['note', 'reminder']
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.done is bool
        && d.deleted is bool
        && (!('deletedAt' in d) || d.deletedAt is number)
        && d.createdBy in uids()
        && d.createdAt is number
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.v is int;
    }

    // ---- Liste de courses ----
    match /shopping/{itemId} {
      allow read: if isMember();
      allow create, update: if isMember() && validItem(request.resource.data);
      // Aucun effacement définitif : un article retiré est seulement masqué
      allow delete: if false;
    }
    function validItem(d) {
      return d.keys().hasAll(['text', 'store', 'done', 'deleted', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.keys().hasOnly(['text', 'store', 'done', 'deleted', 'deletedAt', 'createdBy', 'createdAt', 'updatedAt', 'updatedBy', 'v'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 200
        && d.store is string && d.store.size() <= 40
        && d.done is bool
        && d.deleted is bool
        && (!('deletedAt' in d) || d.deletedAt is number)
        && d.createdBy in uids()
        && d.createdAt is number
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time
        && d.v is int;
    }

    // ---- Réglages partagés (actions et icônes, magasins) ----
    match /config/{docId} {
      allow read: if isMember();
      allow create, update: if isMember() && docId in ['actions', 'stores'] && validActions(request.resource.data);
      allow delete: if false;
    }
    function validActions(d) {
      return d.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && d.items is list && d.items.size() <= 60
        && d.updatedBy == request.auth.uid
        && d.updatedAt == request.time;
    }

    // ---- Copies de sauvegarde ----
    match /backups/{backupId} {
      allow read: if isMember();
      // Une copie ne peut jamais être modifiée après coup
      allow create: if isMember() && validBackup(request.resource.data);
      allow update: if false;
      // Seules les copies de plus de 35 jours peuvent être supprimées (nettoyage automatique)
      allow delete: if isMember() && resource.data.createdAt < request.time - duration.value(35, 'd');
    }
    function validBackup(d) {
      return d.keys().hasOnly(['createdAt', 'createdBy', 'kind', 'count', 'json', 'v'])
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.kind is string
        && d.count is int
        && d.json is string && d.json.size() < 1000000;
    }

    // ---- Tout le reste est interdit ----
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
